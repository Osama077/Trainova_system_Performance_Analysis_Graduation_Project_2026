<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>478af27b-19af-4db9-a304-8c4aa7968afe</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Trainova.Database</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="$(MSBuildThisFileDirectory)FitnessData\Procedures\" />
    <Folder Include="$(MSBuildThisFileDirectory)FitnessData\Views\" />
    <Folder Include="$(MSBuildThisFileDirectory)Profiles\Procedures\" />
    <Folder Include="$(MSBuildThisFileDirectory)Profiles\Views\" />
    <Folder Include="$(MSBuildThisFileDirectory)MedicalStats\Procedures\" />
    <Folder Include="$(MSBuildThisFileDirectory)MedicalStats\Views\" />
    <Folder Include="$(MSBuildThisFileDirectory)tsa\Views\" />
    <Folder Include="$(MSBuildThisFileDirectory)tsa\Procedures\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Profiles\Procedures\**\*.sql">
      <Link>Profiles\Procedures\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include="Profiles\Views\**\*.sql">
      <Link>Profiles\Views\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include="MedicalStats\Procedures\**\*.sql">
      <Link>MedicalStats\Procedures\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include="MedicalStats\Views\**\*.sql">
      <Link>MedicalStats\Views\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\procedures\GetExercises_FilteredAndPaged.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\procedures\GetFitnessSessionExercises.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\procedures\GetPhysicalCapacityHistoryByPlayerId.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\procedures\GetPlayerFitnessMetricsSummary.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\procedures\GetPlayerLoadVsCapacityTimeline.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\procedures\GetRecentPhysicalCapacityTests.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\procedures\GetTeamPlayersFitnessGrid.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\views\FitnessSessionExercises.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\views\PlayerSessionsSummary.sql" />
    <None Include="$(MSBuildThisFileDirectory)fitnessdata\views\PlayerTestsSummary.sql" />
    <None Include="$(MSBuildThisFileDirectory)medicalstats\procedures\GetInjuries.sql" />
    <None Include="$(MSBuildThisFileDirectory)medicalstats\procedures\GetInjuriesCount.sql" />
    <None Include="$(MSBuildThisFileDirectory)medicalstats\procedures\GetInjuryDetailesById.sql" />
    <None Include="$(MSBuildThisFileDirectory)medicalstats\procedures\GetSquadHealthDashboard.sql" />
    <None Include="$(MSBuildThisFileDirectory)tsa\procedures\GetPlayerAdherenceOverTime.sql" />
    <None Include="$(MSBuildThisFileDirectory)tsa\procedures\GetUserAccessPolicyDetails.sql" />
    <None Include="$(MSBuildThisFileDirectory)tsa\procedures\SearchForAccessPolicy.sql" />
  </ItemGroup>
</Project>